{
  "kind": "signatures",
  "source": "ssh_banner",
  "schema_version": 1,
  "review_status": "draft",
  "description": "SSH identification string (RFC 4253 section 4.2) without the trailing CR LF, for example 'SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.10'. Use the banner the host sends as a server; a client banner says what the client runs and is also valid evidence for that host. OS signatures are tried in order and the first match wins. Distribution package versions pin a release because each release ships one OpenSSH version.",
  "signatures": [
    {
      "id": "ssh-ubuntu-24.04",
      "label": "ubuntu-24.04",
      "strength": "strong",
      "match": { "pattern": "^SSH-2\\.0-OpenSSH_9\\.6p1 Ubuntu-3ubuntu" },
      "examples": ["SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13.5"]
    },
    {
      "id": "ssh-ubuntu-22.04",
      "label": "ubuntu-22.04",
