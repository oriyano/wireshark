  "services": [
    { "id": "svc-openssh-windows", "pattern": "^SSH-[\\d.]+-OpenSSH_for_Windows_(?P<version>[\\w.]+)", "product": "OpenSSH for Windows" },
    { "id": "svc-openssh", "pattern": "^SSH-[\\d.]+-OpenSSH_(?P<version>[\\w.]+)", "product": "OpenSSH" },
    { "id": "svc-dropbear", "pattern": "^SSH-[\\d.]+-dropbear(?:_(?P<version>[\\w.]+))?", "product": "Dropbear SSH" },
    { "id": "svc-libssh", "pattern": "^SSH-[\\d.]+-libssh[_-](?P<version>[\\w.]+)", "product": "libssh" },
    { "id": "svc-cisco", "pattern": "^SSH-[\\d.]+-Cisco-(?P<version>[\\w.]+)", "product": "Cisco SSH" },
    { "id": "svc-routeros", "pattern": "^SSH-[\\d.]+-ROSSSH", "product": "MikroTik RouterOS SSH" },
    { "id": "svc-putty", "pattern": "^SSH-[\\d.]+-PuTTY_(?P<version>[\\w.:-]+)", "product": "PuTTY" },
    { "id": "svc-paramiko", "pattern": "^SSH-[\\d.]+-paramiko_(?P<version>[\\w.]+)", "product": "Paramiko" },
    { "id": "svc-go", "pattern": "^SSH-[\\d.]+-Go$", "product": "Go x/crypto/ssh" }
  ]
}
