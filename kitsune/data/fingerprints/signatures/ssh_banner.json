    {
      "id": "ssh-openssh-plain",
      "label": "unix-like",
      "strength": "hint",
      "match": { "pattern": "^SSH-2\\.0-OpenSSH_[\\d.]+(?:p\\d+)?$" },
      "examples": ["SSH-2.0-OpenSSH_9.8", "SSH-2.0-OpenSSH_9.9p1"],
      "notes": "OpenSSH with no distribution suffix: RHEL family, macOS, Alpine, Arch, OpenBSD, and others."
    }
